DATABASE_URL=postgres://user:password@host:port/dbname
FRONTEND_URL=http://localhost:port
DEPLOYED_FRONTEND_URL=https://encyclopedia[...].app
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# #275 — optional. Powers GET /courses/video-duration (estimated module
# time from a YouTube video's real length). Get a key from Google Cloud
# Console with the YouTube Data API v3 enabled. Left unset, that endpoint
# just reports every video as "unsupported" and the trainer falls back to
# entering module time manually — nothing else breaks without it.
YOUTUBE_API_KEY=your-youtube-data-api-v3-key