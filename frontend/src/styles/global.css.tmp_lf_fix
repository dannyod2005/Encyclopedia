/* #367 — this @import moved to a <link> in public/index.html so the
   browser can discover and start the font request from the initial HTML
   parse instead of only after fetching and parsing this stylesheet
   (CSS @import is render-blocking and was adding a hop to Lighthouse's
   critical request chain). Same font families/weights, just loaded from
   the document <head> now. */

/* #104 — Preflight is disabled (see tailwind.config.js), so this only
   adds Tailwind's utility classes (including responsive sm:/md:/lg:
   prefixes) on top of the existing hand-rolled styles below; it doesn't
   reset anything. */
@tailwind base;
@tailwind components;
@tailwind utilities;

html, body {
  min-height: 100%;
  background: var(--paper);
  margin: 0;
  /* #105 — stop the vertical rubber-band overscroll from revealing the
     browser's default (non-ink) background past the top/bottom edge of
     the page on mobile; the sticky topbar loses its "always there" feel
     if the page can bounce past it. Horizontal (edge-swipe back/forward
     navigation) is left alone. */
  overscroll-behavior-y: none;
}

#root {
  min-height: 100vh;
}

:root{
  --ink:#16233D; --ink-70:#16233Db3; --paper:#F7F5EF; --paper-2:#FFFFFF;
  /* #351 — was #96701F (~3.7:1 on --gold-tint — the "X-day streak" pill,
     leaderboard rank, stat-card icons, and gold text links all sit on
     that background — and only ~4.2:1 on --paper). #805F1A holds ~4.8:1
     on --gold-tint, ~5.4:1 on --paper, ~5.9:1 on white — same margin as
     the --slate-light/--coral fixes above, same hue ratio preserved. */
  --gold:#C4922F; --gold-dark:#805F1A; --gold-tint:#F3E7CE;
  /* #351 — was #8B93A0 (~2.8:1 on --paper), well under the 4.5:1 WCAG AA
     minimum for body-sized text. #626B7A holds ~4.9:1 on --paper (and
     ~5.4:1 on --paper-2/white) — comfortably past the threshold rather
     than sitting right on the edge, while staying visibly lighter than
     --slate so the two tokens don't collapse into the same shade. */
  --slate:#5B6472; --slate-light:#626B7A; --line:#E4E0D6;
  /* #351 — was #C1573D (~4.1:1 on --paper, ~4.5:1 on white, ~3.7:1 on
     --coral-tint — the "Unenroll"/"Retake" ghost-button text and the
     white-on-coral destructive-action buttons both failed AA). #A44A34
     holds ~5.3:1 on --paper, ~5.8:1 on white, ~4.8:1 on --coral-tint —
     margin on the toughest of the three pairings this token appears in. */
  --success:#3F7D58; --success-tint:#E4EFE8; --coral:#A44A34; --coral-tint:#F6E5DF;
  --font-display:'Fraunces', serif; --font-body:'Inter', sans-serif; --font-mono:'IBM Plex Mono', monospace;
}
.enc-root{ font-family:var(--font-body); color:var(--ink); background:var(--paper); min-height:100vh; }
.enc-root *{ box-sizing:border-box; }
.enc-btn{ font-family:var(--font-body); font-weight:600; font-size:14px; border-radius:8px; padding:10px 18px; cursor:pointer; border:none; display:inline-flex; align-items:center; gap:6px; transition:opacity .15s ease, transform .1s ease; }
.enc-btn:active{ transform:scale(0.98); }
.enc-btn:hover{ opacity:0.88; }
.enc-btn-primary{ background:var(--ink); color:var(--paper); }
.enc-btn-gold{ background:var(--gold); color:#2B1E06; }
.enc-btn-ghost{ background:transparent; color:var(--ink); border:1px solid var(--line); }
.enc-btn-ghost:hover{ background:var(--paper-2); opacity:1; border-color:var(--slate-light); }
.enc-card{ background:var(--paper-2); border:1px solid var(--line); border-radius:14px; }
/* #332 — shared "wide page" container: keeps the existing 1160 cap up to
   a large-desktop breakpoint, then widens further so pages don't carry a
   big fixed gutter on large monitors. A class (not an inline style)
   because inline maxWidth/margin values can't respond to viewport width
   on their own — this is the pattern #5 (site-wide rollout) reuses on
   the other screens once this one's confirmed. */
.enc-page-wide{ max-width:1160px; margin:0 auto; }
@media (min-width:1440px){
  .enc-page-wide{ max-width:1480px; }
}
/* #336 — generalized version of .enc-page-wide above: rather than every
   page adopting the exact same 1160/1480 numbers (too wide for a
   settings form, too narrow a jump for a 720 leaderboard), each page
   sets its own base width via the --enc-page-base custom property and
   still grows at the same >=1440px breakpoint, by the same ~1.276x
   ratio Dashboard/Learning already grow by (1160 -> 1480). This is the
   single shared primitive the remaining hardcoded-maxWidth pages
   (Catalogue, Home, Trainer Studio, Leaderboard, Settings, course/path
   editors, analytics) adopt instead of each hand-rolling their own
   static cap that never responds to viewport width. */
.enc-page-scaled{ max-width:var(--enc-page-base, 1160px); margin:0 auto; }
@media (min-width:1440px){
  .enc-page-scaled{ max-width:calc(var(--enc-page-base, 1160px) * 1.2759); }
}
.enc-badge{ font-size:11px; font-weight:600; letter-spacing:0.02em; padding:3px 9px; border-radius:100px; text-transform:uppercase; }
.enc-hairline{ border:none; border-top:1px solid var(--line); }
.enc-scroll::-webkit-scrollbar{ width:6px; height:6px; }
.enc-scroll::-webkit-scrollbar-thumb{ background:var(--line); border-radius:10px; }
.enc-nav-item{ display:flex; align-items:center; gap:10px; padding:10px 14px; border-radius:8px; font-size:14px; font-weight:500; color:var(--slate); cursor:pointer; transition:background .15s; }
.enc-nav-item:hover{ background:#FFFFFF10; }
.enc-nav-item.active{ background:var(--paper-2); color:var(--ink); }
.enc-input{ font-family:var(--font-body); border:1px solid var(--line); border-radius:9px; padding:10px 14px 10px 40px; font-size:14px; width:100%; background:var(--paper-2); }
.enc-input:focus{ border-color:var(--gold); }

/* #350 — every text input/select/textarea in the app suppressed the
   browser's default focus outline (outline:none, here and in every
   inline "rowInput"-style object across the trainer editors, plus a
   couple of one-off inline inputs) and relied only on a border-color
   change to signal focus — not visible enough to satisfy WCAG 2.4.7.
   One global :focus-visible rule instead of a per-screen fix; the
   corresponding outline:none removals live alongside each inline
   style so this rule can actually take effect (an inline style
   attribute always wins over an external stylesheet selector). */
input:focus-visible, select:focus-visible, textarea:focus-visible{
  outline:2px solid var(--gold); outline-offset:1px;
}
.enc-tab{ padding:10px 4px; font-size:14px; font-weight:600; color:var(--slate-light); cursor:pointer; border-bottom:2px solid transparent; transition:color .15s ease, border-color .15s ease; }
.enc-tab.active{ color:var(--ink); border-bottom-color:var(--gold); }

/* #105 — subtle UI transitions/polish.
   Kept as a small, reusable set of keyframes + helper classes rather than
   per-component animations, so every "open/switch/navigate" interaction in
   the app gets the same feel. Durations are short (140-220ms) and easing
   is a plain ease/ease-out — deliberately unremarkable, not a demo flourish. */
@keyframes enc-fade-in{ from{ opacity:0; } to{ opacity:1; } }
@keyframes enc-fade-slide-in{ from{ opacity:0; transform:translateY(6px); } to{ opacity:1; transform:translateY(0); } }
@keyframes enc-backdrop-in{ from{ opacity:0; } to{ opacity:1; } }
@keyframes enc-backdrop-out{ from{ opacity:1; } to{ opacity:0; } }
@keyframes enc-modal-in{ from{ opacity:0; transform:scale(.97) translateY(4px); } to{ opacity:1; transform:scale(1) translateY(0); } }
@keyframes enc-modal-out{ from{ opacity:1; transform:scale(1) translateY(0); } to{ opacity:0; transform:scale(.97) translateY(4px); } }

/* Route transitions — applied to each screen's root element; replays
   automatically since React Router mounts a fresh component per route. */
.enc-page-enter{ animation:enc-fade-slide-in 220ms ease both; }

/* Tab-switch content — applied to a tab panel wrapper keyed by the active
   tab, so switching tabs remounts it and replays the fade. */
.enc-tab-panel{ animation:enc-fade-in 160ms ease both; }

/* Modal open/close — .enc-modal-closing is added right before a modal
   unmounts (see CourseDetailModal/AuthModal) so the close also animates
   instead of the modal just vanishing. */
.enc-modal-backdrop{ animation:enc-backdrop-in 160ms ease both; }
.enc-modal-backdrop.enc-modal-closing{ animation:enc-backdrop-out 160ms ease both; }
.enc-modal-card{ animation:enc-modal-in 180ms cubic-bezier(0.16, 1, 0.3, 1) both; }
.enc-modal-card.enc-modal-closing{ animation:enc-modal-out 160ms ease both; }

/* Respect the OS-level reduced-motion preference — every animation/
   transition above (and anything else on the page) collapses to
   effectively instant rather than being disabled selectively. */
@media (prefers-reduced-motion: reduce){
  *, *::before, *::after{
    animation-duration:0.001ms !important;
    animation-iteration-count:1 !important;
    transition-duration:0.001ms !important;
    scroll-behavior:auto !important;
  }
}